diff --git a/Cargo.lock b/Cargo.lock
index e020e71..d624bb8 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -77,6 +77,7 @@ dependencies = [
  "arc-storage",
  "libc",
  "rusqlite",
+ "serde_json",
  "tokio",
 ]
 
diff --git a/Cargo.toml b/Cargo.toml
index 35283a6..d661475 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -22,4 +22,4 @@ rusqlite = { version = "0.41", features = ["bundled"] }
 serde = { version = "1.0", features = ["derive"] }
 serde_json = "1.0"
 sha2 = "0.11"
-tokio = { version = "1", default-features = false, features = ["macros", "net", "rt-multi-thread", "signal"] }
+tokio = { version = "1", default-features = false, features = ["macros", "net", "rt-multi-thread", "signal", "sync", "time"] }
diff --git a/crates/arc-daemon/Cargo.toml b/crates/arc-daemon/Cargo.toml
index 7c10962..f7dc56a 100644
--- a/crates/arc-daemon/Cargo.toml
+++ b/crates/arc-daemon/Cargo.toml
@@ -8,5 +8,9 @@ arc-core.workspace = true
 arc-ipc.workspace = true
 arc-storage.workspace = true
 libc.workspace = true
-rusqlite.workspace = true
+rusqlite = { workspace = true, features = ["hooks"] }
+serde_json.workspace = true
 tokio.workspace = true
+
+[dev-dependencies]
+tokio = { workspace = true, features = ["test-util"] }
