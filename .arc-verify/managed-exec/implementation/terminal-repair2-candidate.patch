+//! Keep the target in the caller job and the observer outside signal broadcasts.
+//! The anchor relays continuation only; it never forwards termination to peers.
+use std::{
+    io::{self, Read},
+    os::{
+        fd::{AsRawFd, FromRawFd, OwnedFd},
+        unix::{net::UnixStream, process::CommandExt},
+    },
+    process::Command,
+    sync::atomic::{AtomicU32, Ordering},
+};
+
+#[repr(C)]
+struct Shared {
+    continued: AtomicU32,
+    suspending: AtomicU32,
+    acknowledged: AtomicU32,
+}
+static mut STATE: *mut Shared = std::ptr::null_mut();
+static mut OBSERVER: libc::pid_t = 0;
+
+extern "C" fn continued(_: i32) {
+    // Runs only in the single-threaded forked anchor. All operations are native
+    // async-signal-safe calls or lock-free shared atomics. No target is signaled.
+    unsafe {
+        let state = &*STATE;
+        let epoch = state
+            .continued
+            .fetch_add(1, Ordering::SeqCst)
+            .wrapping_add(1);
+        loop {
+            if libc::getppid() != OBSERVER {
+                libc::_exit(0);
+            }
+            libc::kill(OBSERVER, libc::SIGCONT);
+            if state.suspending.load(Ordering::SeqCst) == 0
+                || state.acknowledged.load(Ordering::SeqCst) == epoch
+            {
+                break;
+            }
+            // This is an acknowledged continuation protocol, not a delay or
+            // inference from pending signals. Reissue until suspend returns.
+            libc::sched_yield();
+        }
+    }
+}
+
+pub(crate) struct Relay {
+    anchor: libc::pid_t,
+    group: libc::pid_t,
+    stream: Option<UnixStream>,
+    state: *mut Shared,
+    session_tty: Option<OwnedFd>,
+}
+impl Relay {
+    pub(crate) fn open() -> io::Result<Self> {
+        let group = unsafe { libc::getpgrp() };
+        // Candidate experiment: preserve setsid callers via a private target
+        // group instead of relocating a session leader (which is forbidden).
+        if unsafe { libc::getsid(0) == libc::getpid() } {
+            let fd = unsafe { libc::open(c"/dev/tty".as_ptr(), libc::O_RDWR | libc::O_CLOEXEC) };
+            let session_tty = if fd >= 0 {
+                let duplicate = unsafe { libc::fcntl(fd, libc::F_DUPFD_CLOEXEC, 3) };
+                unsafe {
+                    libc::close(fd);
+                }
+                if duplicate < 0 {
+                    return Err(io::Error::last_os_error());
+                }
+                Some(unsafe { OwnedFd::from_raw_fd(duplicate) })
+            } else {
+                None
+            };
+            return Ok(Self {
+                anchor: 0,
+                group,
+                stream: None,
+                state: std::ptr::null_mut(),
+                session_tty,
+            });
+        }
+        let state = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                std::mem::size_of::<Shared>(),
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED | libc::MAP_ANON,
+                -1,
+                0,
+            )
+        };
+        if state == libc::MAP_FAILED {
+            return Err(io::Error::last_os_error());
+        }
+        let state = state.cast::<Shared>();
+        unsafe {
+            state.write(Shared {
+                continued: AtomicU32::new(0),
+                suspending: AtomicU32::new(0),
+                acknowledged: AtomicU32::new(0),
+            });
+        }
+        let (stream, peer) = match UnixStream::pair() {
+            Ok(pair) => pair,
+            Err(error) => {
+                unsafe {
+                    libc::munmap(state.cast(), std::mem::size_of::<Shared>());
+                }
+                return Err(error);
+            }
+        };
+        let observer = unsafe { libc::getpid() };
+        let anchor = unsafe { libc::fork() };
+        if anchor == 0 {
+            unsafe {
+                anchor_main(peer.as_raw_fd(), state, observer);
+            }
+        }
+        drop(peer);
+        if anchor < 0 {
+            let error = io::Error::last_os_error();
+            unsafe {
+                libc::munmap(state.cast(), std::mem::size_of::<Shared>());
+            }
+            return Err(error);
+        }
+        let mut relay = Self {
+            anchor,
+            group,
+            stream: Some(stream),
+            state,
+            session_tty: None,
+        };
+        let mut ready = [0];
+        relay.stream.as_mut().unwrap().read_exact(&mut ready)?;
+        // A separate transient child creates an observer-only group. The
+        // anchor never leaves the original group, even when it has no peers.
+        let (mut control, other) = UnixStream::pair()?;
+        let bootstrap = unsafe { libc::fork() };
+        if bootstrap == 0 {
+            unsafe {
+                libc::close(control.as_raw_fd());
+                if libc::setpgid(0, 0) != 0 {
+                    libc::_exit(1);
+                }
+                let fd = other.as_raw_fd();
+                libc::write(fd, b"r".as_ptr().cast(), 1);
+                let mut byte = 0u8;
+                libc::read(fd, (&mut byte as *mut u8).cast(), 1);
+                libc::_exit(0);
+            }
+        }
+        drop(other);
+        if bootstrap < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let prepared = control.read_exact(&mut ready).and_then(|_| {
+            if unsafe { libc::setpgid(0, bootstrap) } == 0 {
+                Ok(())
+            } else {
+                Err(io::Error::last_os_error())
+            }
+        });
+        drop(control);
+        reap(bootstrap);
+        prepared?;
+        Ok(relay)
+    }
+    pub(crate) fn configure(&self, command: &mut Command) {
+        if self.state.is_null() {
+            command.process_group(0);
+            if let Some(tty) = &self.session_tty {
+                let fd = tty.as_raw_fd();
+                unsafe {
+                    command.pre_exec(move || foreground(fd, libc::getpgrp()));
+                }
+            }
+        } else {
+            command.process_group(self.group);
+        }
+    }
+    pub(crate) fn epoch(&self) -> u32 {
+        if self.state.is_null() {
+            return 0;
+        }
+        unsafe { &*self.state }.continued.load(Ordering::SeqCst)
+    }
+    pub(crate) fn suspend(&self, observed: u32, already_continued: bool, child: u32) {
+        if self.state.is_null() {
+            if let Some(tty) = &self.session_tty {
+                let _ = foreground(tty.as_raw_fd(), self.group);
+            }
+            unsafe {
+                libc::raise(libc::SIGSTOP);
+            }
+            if let Some(tty) = &self.session_tty {
+                let _ = foreground(tty.as_raw_fd(), child as i32);
+            }
+            return;
+        }
+        let state = unsafe { &*self.state };
+        state.suspending.store(1, Ordering::SeqCst);
+        if !already_continued && self.epoch() == observed {
+            unsafe {
+                libc::raise(libc::SIGSTOP);
+            }
+        }
+        state.acknowledged.store(self.epoch(), Ordering::SeqCst);
+        state.suspending.store(0, Ordering::SeqCst);
+    }
+}
+unsafe fn anchor_main(fd: i32, state: *mut Shared, observer: i32) {
+    STATE = state;
+    OBSERVER = observer;
+    // Do not retain caller pipes, terminal descriptors or unrelated resources.
+    for descriptor in 0..libc::getdtablesize() {
+        if descriptor != fd {
+            libc::close(descriptor);
+        }
+    }
+    for signal in [
+        libc::SIGINT,
+        libc::SIGQUIT,
+        libc::SIGTERM,
+        libc::SIGHUP,
+        libc::SIGTSTP,
+        libc::SIGTTIN,
+        libc::SIGTTOU,
+    ] {
+        libc::signal(signal, libc::SIG_IGN);
+    }
+    let mut action: libc::sigaction = std::mem::zeroed();
+    action.sa_sigaction = continued as *const () as usize;
+    action.sa_flags = libc::SA_RESTART;
+    libc::sigemptyset(&mut action.sa_mask);
+    libc::sigaction(libc::SIGCONT, &action, std::ptr::null_mut());
+    if libc::write(fd, b"r".as_ptr().cast(), 1) != 1 {
+        libc::_exit(1);
+    }
+    let mut byte = 0u8;
+    loop {
+        let n = libc::read(fd, (&mut byte as *mut u8).cast(), 1);
+        if n == 0 {
+            libc::_exit(0);
+        }
+        if n < 0 && io::Error::last_os_error().kind() != io::ErrorKind::Interrupted {
+            libc::_exit(1);
+        }
+    }
+}
+fn reap(pid: i32) {
+    loop {
+        if unsafe { libc::waitpid(pid, std::ptr::null_mut(), 0) } >= 0 {
+            break;
+        }
+        if io::Error::last_os_error().kind() != io::ErrorKind::Interrupted {
+            break;
+        }
+    }
+}
+impl Drop for Relay {
+    fn drop(&mut self) {
+        if self.state.is_null() {
+            if let Some(tty) = &self.session_tty {
+                let _ = foreground(tty.as_raw_fd(), self.group);
+            }
+            return;
+        }
+        // The direct child remains unreaped until after the last anchor signal.
+        // Rejoin before releasing the anchor so the original group still exists.
+        unsafe {
+            libc::setpgid(0, self.group);
+        }
+        self.stream.take();
+        unsafe {
+            libc::kill(self.anchor, libc::SIGCONT);
+        }
+        reap(self.anchor);
+        unsafe {
+            libc::munmap(self.state.cast(), std::mem::size_of::<Shared>());
+        }
+    }
+}
+
+fn foreground(fd: i32, group: i32) -> io::Result<()> {
+    unsafe {
+        let prior = libc::signal(libc::SIGTTOU, libc::SIG_IGN);
+        let rc = libc::tcsetpgrp(fd, group);
+        let error = io::Error::last_os_error();
+        libc::signal(libc::SIGTTOU, prior);
+        if rc == 0 {
+            Ok(())
+        } else {
+            Err(error)
+        }
+    }
+}
