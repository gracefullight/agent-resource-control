+#!/usr/bin/env bash
+set -euo pipefail
+# Separate setup, never called by the gate. Exact release + upstream Cargo.lock.
+mise install
+rustup component add llvm-tools-preview --toolchain 1.95.0
+cargo +1.95.0 install cargo-llvm-cov --version 0.6.21 --locked
+cargo +1.95.0 fetch --locked
diff --git a/scripts/coverage/run.ts b/scripts/coverage/run.ts
new file mode 100644
index 0000000..7373941
--- /dev/null
+++ b/scripts/coverage/run.ts
@@ -0,0 +1,112 @@
+import { mkdirSync, writeFileSync, readFileSync, existsSync, readdirSync, statSync } from "node:fs";
+import { resolve, relative, join, dirname } from "node:path";
+import { BASELINE, PINS, EVIDENCE, CRATES } from "./config";
+import { hash, sourceInventory, inputIdentity, walk } from "./source";
+import { requireExit, requireVersion, validateReport, enforce } from "./gate";
+import { command, type Receipt } from "./commands";
+
+const root=resolve(import.meta.dir,"../..");
+const id=`${new Date().toISOString().replace(/[:.]/g,"-")}-${crypto.randomUUID()}`;
+const dir=resolve(root,EVIDENCE,"baseline/runs",id);
+mkdirSync(dir,{recursive:true});
+const save=(name:string,value:unknown)=>writeFileSync(resolve(dir,name),JSON.stringify(value,null,2)+"\n");
+const receipts:Receipt[]=[];
+const env={...process.env,RUSTUP_TOOLCHAIN:PINS.rust,CARGO_NET_OFFLINE:"true",CARGO_TERM_COLOR:"never"};
+const rust=["rustup","run",PINS.rust];
+async function run(argv:string[],label:string,extra:Record<string,string>={},expected=0,timeout=120000) {
+  const receipt=await command(argv,dir,root,{...env,...extra},timeout); receipts.push(receipt);
+  if(receipt.exit!==expected) throw Error(`${label}: exited ${receipt.exit}; ${receipt.stderr.trim()}`);
+  return receipt;
+}
+let input:ReturnType<typeof inputIdentity>|undefined;
+let inventory:ReturnType<typeof sourceInventory>|undefined;
+let measured=false;
+try {
+  console.log("Coverage: checking pinned tools (setup: mise run coverage:provision)");
+  input=inputIdentity(root); inventory=sourceInventory(root);
+  save("inputs.json",input);save("source-inventory.json",inventory);
+  requireVersion(Bun.version,PINS.bun,"Bun");
+  const rustc=await run([...rust,"rustc","-Vv"],"MISSING_TOOL rustc");
+  if(!rustc.stdout.includes(`release: ${PINS.rust}\n`)) throw Error("TOOL_VERSION: Rust release mismatch");
+  const host=rustc.stdout.match(/^host: (.+)$/m)?.[1];
+  if(!host || !/(apple-darwin|unknown-linux)/.test(host)) throw Error(`PLATFORM: unsupported measurement host ${host}`);
+  const cov=await run([...rust,"cargo","llvm-cov","--version"],"MISSING_TOOL cargo-llvm-cov");
+  requireVersion(cov.stdout,`cargo-llvm-cov ${PINS.cargoLlvmCov}`,"cargo-llvm-cov");
+  const sysroot=(await run([...rust,"rustc","--print","sysroot"],"MISSING_TOOL sysroot")).stdout.trim();
+  const llvm=resolve(sysroot,"lib/rustlib",host,"bin");
+  const versions:Record<string,string>={bun:Bun.version,rustc:rustc.stdout,cargoLlvmCov:cov.stdout,host};
+  for(const name of ["llvm-cov","llvm-profdata"]) {
+    if(!existsSync(join(llvm,name))) throw Error(`MISSING_TOOL: ${name}; run mise run coverage:provision`);
+    const receipt=await run([join(llvm,name),"--version"],`MISSING_TOOL ${name}`);
+    const rustLlvm=rustc.stdout.match(/LLVM version: (\S+)/)?.[1];
+    if(!rustLlvm || !receipt.stdout.includes(rustLlvm)) throw Error(`TOOL_VERSION: ${name} must match Rust LLVM ${rustLlvm}`);
+    versions[name]=receipt.stdout;
+  }
+  save("versions.json",versions);
+  const overrides=["RUSTFLAGS","CARGO_ENCODED_RUSTFLAGS","LLVM_COV_FLAGS","LLVM_PROFDATA_FLAGS","RUSTC_WRAPPER","RUSTC_WORKSPACE_WRAPPER","CARGO_BUILD_TARGET",
+    ...Object.keys(process.env).filter(k=>/^CARGO_(?:PROFILE_|TARGET_.*RUSTFLAGS)/.test(k))];
+  for(const name of overrides) {
+    if(process.env[name]) throw Error(`CONFIGURATION: unset ${name} for the pinned measurement`);
+  }
+  const metadata=JSON.parse((await run([...rust,"cargo","metadata","--format-version","1","--locked","--offline"],"METADATA_FAILURE")).stdout);
+  const names=metadata.packages.filter((p:any)=>metadata.workspace_members.includes(p.id)).map((p:any)=>p.name).sort();
+  if(JSON.stringify(names)!==JSON.stringify([...CRATES].sort())) throw Error("MISSING_CRATE: workspace members differ from accounting contract");
+  save("metadata.json",metadata);
+  // Disable the tool's broad tests-directory filter: path-included production
+  // modules may contain tests/../src in their recorded filename. Only exact
+  // non-workspace dependency and compiler-source roots are filtered upstream.
+  const escape=(s:string)=>s.replace(/[.*+?^${}()|[\]\\]/g,"\\$&");
+  const dependencyRoots=metadata.packages.filter((p:any)=>!metadata.workspace_members.includes(p.id)).map((p:any)=>dirname(p.manifest_path));
+  for(const dep of dependencyRoots) if(root===dep || root.startsWith(dep+"/")) throw Error(`CONFIGURATION: dependency root overlaps workspace ${dep}`);
+  const compilerHash=rustc.stdout.match(/^commit-hash: (.+)$/m)?.[1];
+  const ignoredRoots=[sysroot,`/rustc/${compilerHash}`,...dependencyRoots];
+  const ignore=ignoredRoots.map(p=>`^${escape(p)}(/|$)`).join("|");
+  save("non-workspace-roots.json",ignoredRoots);
+  // A new run owns its target and profiles; no prior artifact can satisfy it.
+  const target=resolve(root,"target/arc-coverage",id);mkdirSync(target,{recursive:true});
+  const coverageEnv={CARGO_LLVM_COV_TARGET_DIR:target,LLVM_PROFILE_FILE_NAME:"arc-%p-%m.profraw",CARGO_LLVM_COV_DENY_WARNINGS:"1",LLVM_COV:join(llvm,"llvm-cov"),LLVM_PROFDATA:join(llvm,"llvm-profdata")};
+  console.log("Coverage: running workspace unit, integration and child-binary tests");
+  await run([...rust,"cargo","llvm-cov","--workspace","--all-targets","--locked","--offline","--no-clean","--no-report","--no-cfg-coverage","--no-cfg-coverage-nightly"],"TEST_FAILURE",coverageEnv,0,120000);
+  // Explicit binary probes supply independently identifiable child PIDs/profile
+  // files in addition to the existing integration suites' inherited profiles.
+  const childProof=[];
+  for(const [binary,args,expected,extra] of [
+    ["arcctl",["--help"],0,{}],
+    ["arc-daemon",[],1,{ARC_SOCKET_PATH:"relative-invalid-coverage-socket",ARC_DB_PATH:join(dir,"probe.sqlite3")}],
+  ] as [string,string[],number,Record<string,string>][]) {
+    const receipt=await run([join(target,"debug",binary),...args],`CHILD_FAILURE ${binary}`,{...coverageEnv,...extra,LLVM_PROFILE_FILE:join(target,"arc-%p-%m.profraw")},expected);
+    const profiles=readdirSync(target).filter(p=>p.startsWith(`arc-${receipt.pid}-`)&&p.endsWith(".profraw"));
+    if(!profiles.length) throw Error(`CHILD_PROFILE: no profile for ${binary} pid ${receipt.pid}`);
+    for(const profile of profiles) if(!statSync(join(target,profile)).size) throw Error(`CHILD_PROFILE: empty ${profile}`);
+    childProof.push({binary,pid:receipt.pid,profiles,exit:receipt.exit});
+  }
+  const profiles=readdirSync(target).filter(p=>p.endsWith(".profraw")).sort();
+  if(!profiles.length) throw Error("MISSING_REPORT: no raw profiles");
+  console.log("Coverage: merging fresh execution profiles and validating reports");
+  const report=join(dir,"raw.lcov"), started=Date.now();
+  await run([...rust,"cargo","llvm-cov","report","--lcov","--output-path",report,"--failure-mode","any","--disable-default-ignore-filename-regex","--ignore-filename-regex",ignore,"--verbose"],"REPORT_FAILURE",coverageEnv);
+  // The pinned tool writes the exact llvm-profdata -f input list. Check that
+  // every collected profile, including explicit child PIDs, entered this merge.
+  const lists=readdirSync(target).filter(p=>p.endsWith("-profraw-list"));
+  if(lists.length!==1) throw Error("CHILD_PROFILE: missing merge input list");
+  const merge=readFileSync(join(target,lists[0]),"utf8").trim().split("\n").sort();
+  if(JSON.stringify(merge)!==JSON.stringify(profiles.map(p=>join(target,p)).sort())) throw Error("CHILD_PROFILE: merge input mismatch");
+  save("profiles.json",{target,childProof,merge,profiles:profiles.map(p=>({path:p,sha256:hash(readFileSync(join(target,p))),size:statSync(join(target,p)).size}))});
+  const after=inputIdentity(root);
+  const result=validateReport({path:report,started,before:input.sha256,after:after.sha256,inventory,root,testExit:0});
+  measured=true;
+  save("summary.json",{...result,runId:id,acceptedBaseline:BASELINE,host,inputs:input,versions,childProof});
+  writeFileSync(join(dir,"uncovered.md"),result.files.map(f=>`${f.path}: ${f.covered}/${f.total}; uncovered: ${f.uncovered.join(", ")||"none"}`).join("\n")+"\n");
+  for(const crate of result.crates) console.log(`${crate.pass?"PASS":"FAIL"} ${crate.crate}: ${crate.covered}/${crate.total} production lines (${crate.percent.toFixed(2)}%; requires 80%)`);
+  console.log(`Coverage reports: ${relative(root,dir)}`);
+  enforce(result);
+  save("receipt.json",{schemaVersion:1,runId:id,pass:true,exit:0,acceptedBaseline:BASELINE,sourceHash:input.sha256,receipts});
+  writeFileSync(resolve(root,EVIDENCE,"baseline/latest.json"),JSON.stringify({runId:id,directory:relative(root,dir),sourceHash:input.sha256,pass:true})+"\n");
+} catch(error) {
+  const message=String(error);
+  save("receipt.json",{schemaVersion:1,runId:id,pass:false,exit:1,error:message,acceptedBaseline:BASELINE,sourceHash:input?.sha256,receipts});
+  writeFileSync(resolve(root,EVIDENCE,"baseline/latest.json"),JSON.stringify({runId:id,directory:relative(root,dir),sourceHash:input?.sha256,pass:false})+"\n");
+  console.error(`Coverage unavailable or failed: ${message}\nEvidence: ${relative(root,dir)}`);
+  if(!measured) for(const crate of CRATES) console.error(`UNAVAILABLE ${crate}: no valid current measurement`);
+  process.exitCode=1;
+}
diff --git a/scripts/coverage/source.ts b/scripts/coverage/source.ts
new file mode 100644
index 0000000..b4b45c0
--- /dev/null
+++ b/scripts/coverage/source.ts
@@ -0,0 +1,160 @@
+import { readdirSync, readFileSync, realpathSync, existsSync } from "node:fs";
+import { resolve, relative, dirname, basename, join } from "node:path";
+import { createHash } from "node:crypto";
+import { CRATES } from "./config";
+
+export const hash = (data: string | Buffer) => createHash("sha256").update(data).digest("hex");
+export function walk(root: string): string[] {
+  return readdirSync(root, { withFileTypes: true }).sort((a,b) => a.name.localeCompare(b.name))
+    .flatMap(e => e.isDirectory() ? walk(join(root,e.name)) : [join(root,e.name)]);
+}
+type Token = { text: string; start: number; end: number; line: number };
+// Skip Rust comments and literals, retaining literal text as one opaque token.
+// Positions stay in the original source; braces inside text never affect balancing.
+export function tokens(source: string): Token[] {
+  const result: Token[] = [];
+  let i = 0, line = 1;
+  const advance = (end: number) => { line += (source.slice(i,end).match(/\n/g) ?? []).length; i = end; };
+  while (i < source.length) {
+    if (/\s/.test(source[i])) { advance(i+1); continue; }
+    if (source.startsWith("//",i)) { const end=source.indexOf("\n",i); advance(end<0?source.length:end); continue; }
+    if (source.startsWith("/*",i)) {
+      let end=i+2, depth=1;
+      while(end<source.length && depth) {
+        if(source.startsWith("/*",end)) {depth++;end+=2;}
+        else if(source.startsWith("*/",end)) {depth--;end+=2;} else end++;
+      }
+      if(depth) throw Error("SOURCE: unclosed block comment");
+      advance(end); continue;
+    }
+    const start=i, startLine=line;
+    const raw=source.slice(i).match(/^(?:br|r)(#*)"/);
+    if(raw) {
+      const end=source.indexOf('"'+raw[1],i+raw[0].length);
+      if(end<0) throw Error("SOURCE: unclosed raw string");
+      advance(end+1+raw[1].length);
+    } else if(source[i]==='"' || (source[i]==="'" && /^'(?:\\.|[^'\\\n])'/.test(source.slice(i)))) {
+      const quote=source[i]; let end=i+1;
+      while(end<source.length) { if(source[end]==="\\") {end+=2;continue;} if(source[end++]===quote) break; }
+      advance(end);
+    } else {
+      const word=source.slice(i).match(/^[A-Za-z_][A-Za-z_0-9]*/);
+      advance(i+(word?.[0].length ?? 1));
+    }
+    result.push({text:source.slice(start,i),start,end:i,line:startLine});
+  }
+  return result;
+}
+function closing(ts: Token[], start: number): number {
+  const pairs: Record<string,string> = {"[":"]","(":")","{":"}"};
+  const end=pairs[ts[start]?.text];
+  if(!end) throw Error("SOURCE: expected opening delimiter");
+  for(let i=start+1;i<ts.length;i++) {
+    if(pairs[ts[i].text]) {i=closing(ts,i);continue;}
+    if(ts[i].text===end) return i;
+  }
+  throw Error("SOURCE: unbalanced delimiters");
+}
+// Three-valued cfg evaluation: only predicates provably false without `test`
+// are omitted. Platform/features stay unknown and therefore in production scope.
+function cfgWithoutTest(ts: string[]): boolean | undefined {
+  if(ts.length===1 && ts[0]==="test") return false;
+  if(["all","any","not"].includes(ts[0]) && ts[1]==="(" && ts.at(-1)===")") {
+    const args: string[][]=[]; let depth=0, start=2;
+    for(let i=2;i<ts.length-1;i++) {
+      if(ts[i]==="(") depth++; if(ts[i]===")") depth--;
+      if(ts[i]==="," && depth===0) {args.push(ts.slice(start,i));start=i+1;}
+    }
+    if(start<ts.length-1) args.push(ts.slice(start,-1));
+    const values=args.map(cfgWithoutTest);
+    if(ts[0]==="not") return values.length===1 && values[0]!==undefined ? !values[0] : undefined;
+    if(ts[0]==="all") return values.includes(false)?false:values.every(x=>x===true)?true:undefined;
+    return values.includes(true)?true:values.every(x=>x===false)?false:undefined;
+  }
+  return undefined;
+}
+export function analyzeSource(source: string) {
+  const ts=tokens(source), omitted=new Set<number>();
+  const modules: {name:string;path?:string;testOnly:boolean}[]=[];
+  const spans: {start:number;end:number;reason:string}[]=[];
+  let attrs: string[][]=[], attrStart=0;
+  for(let i=0;i<ts.length;i++) {
+    if(ts[i].text==="#" && ts[i+1]?.text==="[") {
+      const end=closing(ts,i+1);
+      if(!attrs.length) attrStart=i;
+      attrs.push(ts.slice(i+2,end).map(t=>t.text)); i=end; continue;
+    }
+    const testOnly=attrs.some(a=>a[0]==="cfg" && cfgWithoutTest(a.slice(2,-1))===false);
+    if(ts[i].text==="mod" && ts[i+2]?.text===";") {
+      const path=attrs.find(a=>a[0]==="path")?.[2];
+      modules.push({name:ts[i+1].text,path:path?JSON.parse(path):undefined,testOnly});
+    }
+    if(testOnly) {
+      let end=i, angles=0;
+      for(;end<ts.length;end++) {
+        const t=ts[end].text;
+        if(t==="{") {end=closing(ts,end);break;}
+        if(t==="<") angles++;
+        if(t===">" && ts[end-1]?.text!=="-" && angles) angles--;
+        if(t===";" || (t==="," && !angles)) break;
+        if(t==="[" || t==="(") end=closing(ts,end);
+      }
+      if(end>=ts.length) throw Error("SOURCE: unsupported test-only item");
+      if(ts[attrStart-1]?.line===ts[attrStart].line || ts[end+1]?.line===ts[end].line) {
+        throw Error(`SOURCE: test-only item at ${ts[attrStart].line}-${ts[end].line} shares a line with other code; line accounting is ambiguous`);
+      }
+      spans.push({start:ts[attrStart].line,end:ts[end].line,reason:"cfg false when test is disabled"});
+      for(let l=ts[attrStart].line;l<=ts[end].line;l++) omitted.add(l);
+      // External test module declarations are recorded above; inline children
+      // cannot be production when their enclosing item is disabled.
+      i=end;
+    }
+    // Visibility can appear between the attributes and the item keyword.
+    if(!["pub","crate"].includes(ts[i].text) && !(ts[i].text==="(" && ts[i-1]?.text==="pub")) attrs=[];
+    if(ts[i].text==="(" && ts[i-1]?.text==="pub") i=closing(ts,i);
+  }
+  return {omitted,modules,spans};
+}
+export type SourceFile = { path:string; crate:string; sha256:string; lines:number; omitted:number[]; testOnly:boolean; spans:ReturnType<typeof analyzeSource>["spans"] };
+export function sourceInventory(root: string): SourceFile[] {
+  const files=CRATES.flatMap(crate=>walk(resolve(root,"crates",crate,"src"))).filter(p=>p.endsWith(".rs"));
+  const testFiles=CRATES.flatMap(crate=>{
+    const dir=resolve(root,"crates",crate,"tests");
+    return existsSync(dir)?walk(dir).filter(p=>p.endsWith(".rs")):[];
+  });
+  const analyses=new Map([...files,...testFiles].map(p=>[realpathSync(p),analyzeSource(readFileSync(p,"utf8"))]));
+  const production=new Set<string>(), tests=new Set<string>();
+  function visit(file:string,test:boolean,entry=false) {
+    file=realpathSync(file); const seen=test?tests:production;
+    if(seen.has(file)) return; seen.add(file);
+    const info=analyses.get(file);
+    if(!info && test && /^crates\/[^/]+\/tests\//.test(relative(root,file))) return;
+    if(!info) throw Error(`SOURCE: module outside src: ${file}`);
+    if(!test && !files.includes(file)) throw Error(`SOURCE: production module outside inventoried src: ${file}`);
+    for(const mod of info.modules) {
+      const base=entry || ["main.rs","lib.rs","mod.rs"].includes(basename(file))?dirname(file):file.slice(0,-3);
+      const candidates=mod.path?[resolve(dirname(file),mod.path)]:[resolve(base,mod.name+".rs"),resolve(base,mod.name,"mod.rs")];
+      const child=candidates.find(existsSync);
+      if(!child) throw Error(`SOURCE: missing module ${file}: ${mod.name}`);
+      visit(child,test||mod.testOnly);
+    }
+  }
+  for(const crate of CRATES) for(const entry of ["lib.rs","main.rs"]) {
+    const p=resolve(root,"crates",crate,"src",entry); if(existsSync(p)) visit(p,false,true);
+  }
+  for(const file of testFiles.filter(p=>dirname(p)===resolve(root,"crates",relative(root,p).split("/")[1],"tests"))) visit(file,true,true);
+  return files.map(file=>{
+    const path=relative(root,file), info=analyses.get(realpathSync(file))!;
+    if(!production.has(realpathSync(file)) && !tests.has(realpathSync(file))) throw Error(`SOURCE: unclassified src file ${path}`);
+    const text=readFileSync(file,"utf8");
+    return {path,crate:path.split("/")[1],sha256:hash(text),lines:text.split("\n").length,omitted:[...info.omitted],spans:info.spans,testOnly:!production.has(realpathSync(file))};
+  }).sort((a,b)=>a.path.localeCompare(b.path));
+}
+export function inputIdentity(root:string) {
+  const paths=["Cargo.toml","Cargo.lock","rust-toolchain.toml","mise.toml","package.json",
+    ".arc-verify/rust-coverage/contract/accounting.json",
+    ...[".cargo/config",".cargo/config.toml","build.rs"].filter(p=>existsSync(resolve(root,p))),
+    ...walk(resolve(root,"crates")).map(p=>relative(root,p)),...walk(resolve(root,"scripts/coverage")).map(p=>relative(root,p))];
+  const files=Object.fromEntries([...new Set(paths)].sort().map(p=>[p,hash(readFileSync(resolve(root,p)))]));
+  return {sha256:hash(JSON.stringify(files)),files};
+}
