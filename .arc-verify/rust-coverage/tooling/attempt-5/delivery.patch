+test("test exit is checked before report validity",()=>check(a=>{a.testExit=7;a.path="missing"},"TEST_FAILURE: exited 7"));
+test("missing tool returns nonzero",()=>check(a=>{a.mode="tool"},"MISSING_TOOL: exited 127"));
