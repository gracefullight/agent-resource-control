+},"BELOW_THRESHOLD"));
+
+test("inconsistent LF/LH cannot inflate coverage to a passing verdict",()=>check((_,f)=>{
+  const bad=f.inventory.map(x=>f.record(x.path,[1]).replace("LF:1","LF:100")).join("");
