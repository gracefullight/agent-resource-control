{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "serena": {
      "command": "oma",
      "args": [
        "bridge",
        "--context",
        "oma"
      ],
      "env": {
        "SERENA_LOG_LEVEL": "info"
      }
    },
    "av": {
      "command": "av",
      "args": [
        "mcp",
        "--workspace",
        "/Users/gracefullight/workspace/arc"
      ]
    }
  }
}
