{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Resource Control",
  "version": "0.1.0",
  "identifier": "dev.arc.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Resource Control",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["desktop"]
    }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png"] }
}
