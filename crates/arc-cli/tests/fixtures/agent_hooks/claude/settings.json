{
  "theme": "dark",
  "permissions": {"deny": ["Bash(rm *)"], "allow": ["Read"]},
  "hooks": {
    "PreToolUse": [
      {"matcher": "Read", "hooks": [{"type": "command", "command": "first-hook"}]},
      {"matcher": "Bash", "hooks": [
        {"type": "command", "command": "before-one"},
        {"type": "command", "command": "before-two"}
      ]}
    ],
    "Stop": [{"hooks": [{"type": "command", "command": "stop-hook"}]}]
  },
  "futureSetting": {"nested": [1, true, null]}
}
